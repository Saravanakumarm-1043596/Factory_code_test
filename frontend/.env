VITE_API_BASE_URL=http://localhost:8000
# 'mock'  -> all CRUD actions run entirely in the browser against
#            generated dummy data (persisted to localStorage). No
#            backend required -- this is the default so the UI is
#            fully testable on its own.
# 'live'  -> calls the FastAPI backend at VITE_API_BASE_URL instead.
VITE_DATA_SOURCE=mock
